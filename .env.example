# ─────────────────────────────────────────────
#  Roa Brew — variables de entorno
#  Copia este archivo como .env y complétalo
# ─────────────────────────────────────────────

# Base de datos PostgreSQL.
# En EasyPanel: crea un servicio Postgres y pega aquí su "Connection URL" interna.
DATABASE_URL="postgresql://roabrew:roabrew_dev_password@localhost:5432/roabrew?schema=public"

# Clave para firmar la sesión del panel admin.
# Genera una con:  openssl rand -base64 48
AUTH_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria-de-al-menos-32-caracteres"

# Usuario inicial del panel admin (se crea al correr el seed).
# Si dejas ADMIN_PASSWORD vacío, el seed genera una aleatoria y la imprime
# una sola vez en la consola. Nunca uses una contraseña de ejemplo en producción.
ADMIN_EMAIL="admin@roabrew.com"
ADMIN_PASSWORD=""

# URL pública del sitio (para metadatos / Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Modo lanzamiento: en "true" el público solo ve la cuenta regresiva.
# El equipo entra por /roaTest2026 y sale por /roaTest2026?salir=1
# El panel /admin sigue accesible siempre (con su propia contraseña).
# Quítala o ponla en "false" el día del lanzamiento.
COMING_SOON="false"
