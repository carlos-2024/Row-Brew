{
  "name": "roa-brew",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma db push --accept-data-loss && tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.5.0",
    "bcryptjs": "2.4.3",
    "jose": "5.9.6",
    "next": "15.5.23",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.0.17",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.13.14",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "prisma": "6.5.0",
    "tailwindcss": "4.0.17",
    "tsx": "4.19.3",
    "typescript": "5.8.2"
  }
}
