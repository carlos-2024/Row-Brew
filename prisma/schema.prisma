generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Catálogo ─────────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  tagline     String? // "Té frío + Fruta + bobas"
  description String?
  /// Qué se sirve en esta familia: bebida | comida | postre.
  /// Decide cómo se dibuja el producto cuando no tiene foto — un vaso no
  /// sirve para un cheesecake — y cómo se le llama en la carta.
  kind        String    @default("bebida")
  /// Tema visual de la sección: green | cream | black | purple
  theme       String    @default("green")
  emoji       String    @default("🧋")
  position    Int       @default(0)
  active      Boolean   @default(true)
  products    Product[]
  promos      Promo[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Segunda clasificación, transversal a las familias: un matcha y un cold
/// brew pueden ser los dos Signature. Se administra desde el panel, como las
/// familias, para poder sumar otras (Temporada, Nuevo) sin tocar el código.
model Subcategory {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  position Int       @default(0)
  active   Boolean   @default(true)
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  price       Decimal     @db.Decimal(10, 2)
  imageUrl    String?
  /// nuevo | estrella | null
  badge       String?
  size        String? // "16oz", "12oz"
  /// frio | caliente. Cambia el dibujo — vaso con hielo y sorbete, o vaso de
  /// papel con vapor — y es el dato para separar la carta por temperatura.
  /// Frío por defecto: es lo que eran todas las bebidas al agregar el campo.
  temperature String      @default("frio")
  /// Si entra en la promo automática de su categoría
  promoEligible Boolean   @default(true)
  featured    Boolean     @default(false)
  active      Boolean     @default(true)
  position    Int         @default(0)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// Clásico, Signature… Opcional: borrar una subcategoría no borra sus
  /// productos, solo los deja sin ella.
  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  /// Si viene de una marca aliada. Estos productos NO salen en la carta:
  /// se muestran solo en la sección de aliados, aunque se compran igual.
  allyId String?
  ally   Ally?   @relation(fields: [allyId], references: [id], onDelete: SetNull)

  /// Promos que incluyen esta bebida. Si una promo no lista ninguna,
  /// entran todas las de su categoría.
  promos      Promo[]     @relation("PromoProducts")

  /// Grupos de opcionales que ofrece, además de los extras sueltos
  extraGroups ExtraGroup[] @relation("ProductExtraGroups")

  orderItems  OrderItem[]
  /// ── SEO ──
  /// Lo que ve el buscador, aparte de lo que ve el cliente. Se guarda por
  /// separado para poder escribir un titular largo y con ubicación sin
  /// ensuciar el nombre corto que va en la carta.
  /// Vacío: se arma con el nombre y la descripción.
  metaTitle       String?
  metaDescription String?
  /// Palabras clave separadas por coma
  seoKeywords     String?
  /// Texto alternativo de la imagen, para lectores de pantalla y para Google
  imageAlt        String?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId])
  @@index([allyId])
  @@index([subcategoryId])
}

/// Grupo de opcionales: "Leche", "Boba", "Tipo de café".
///
/// Existe para que cada producto ofrezca solo lo que le corresponde: una
/// lista plana obligaba a mostrarle "Shot extra de cold brew" a un matcha.
model ExtraGroup {
  id   String @id @default(cuid())
  name String
  /// Texto de ayuda bajo el título, p. ej. "elige una"
  hint String?

  /// Cuántas opciones puede marcar el cliente. 0 es sin límite; 1 hace que
  /// elegir una desmarque la anterior, como el tipo de leche.
  maxChoices Int     @default(0)
  position   Int     @default(0)
  active     Boolean @default(true)

  extras   Extra[]
  /// Productos que lo ofrecen. Vacío: no lo ofrece nadie.
  products Product[] @relation("ProductExtraGroups")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Extra {
  id       String  @id @default(cuid())
  name     String
  price    Decimal @db.Decimal(10, 2)
  active   Boolean @default(true)
  position Int     @default(0)

  /// Sin grupo se sigue ofreciendo en todos los productos, que es como
  /// funcionaban los extras antes de que existieran los grupos.
  groupId String?
  group   ExtraGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([groupId])
}

model Promo {
  id         String    @id @default(cuid())
  title      String // "Sparkling Tea"
  label      String // "2x20"
  detail     String? // "Bebidas con Popping boba"
  price      Decimal   @db.Decimal(10, 2)
  /// Cantidad de bebidas incluidas en el combo
  quantity   Int       @default(2)
  imageUrl   String?
  theme      String    @default("purple")
  /// Se aplica sola en el carrito al juntar `quantity` bebidas de su categoría.
  /// Apagada por defecto: una categoría puede tener varias promos y hay que
  /// elegir explícitamente cuál cobra el carrito.
  autoApply  Boolean   @default(false)
  active     Boolean   @default(true)
  position   Int       @default(0)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Bebidas concretas que entran en la promo. Una categoría puede tener
  /// varias promos distintas (Matcha tiene 2x22 de frutados y 2x25), así que
  /// el interruptor por producto no alcanza para separarlas.
  /// Vacío significa "todas las de la categoría", que es como funcionaba antes.
  products   Product[] @relation("PromoProducts")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ───────────────────────────── Aliados ─────────────────────────────

/// Marcas aliadas: su historia, su galería y los productos que vendemos.
model Ally {
  id      String  @id @default(cuid())
  name    String
  slug    String  @unique
  /// Texto de la tarjeta del inicio, también se usa bajo el nombre en su página
  tagline String?
  /// Imagen de la tarjeta del inicio
  coverUrl String?
  /// Titular de la historia
  storyTitle String?
  /// Historia completa. Los saltos de línea dobles separan párrafos.
  story   String?
  logoUrl String?

  position Int     @default(0)
  active   Boolean @default(true)

  images        AllyImage[]
  discountCodes DiscountCode[]
  products Product[]
  /// ── SEO ──
  /// Lo que ve el buscador, aparte de lo que ve el cliente. Se guarda por
  /// separado para poder escribir un titular largo y con ubicación sin
  /// ensuciar el nombre corto que va en la carta.
  /// Vacío: se arma con el nombre y la descripción.
  metaTitle       String?
  metaDescription String?
  /// Palabras clave separadas por coma
  seoKeywords     String?
  /// Texto alternativo de la imagen, para lectores de pantalla y para Google
  imageAlt        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AllyImage {
  id       String  @id @default(cuid())
  allyId   String
  ally     Ally    @relation(fields: [allyId], references: [id], onDelete: Cascade)
  url      String
  caption  String?
  position Int     @default(0)

  @@index([allyId])
}

// ───────────────────────────── Pedidos ─────────────────────────────

enum OrderStatus {
  PENDIENTE
  CONFIRMADO
  PREPARANDO
  ENTREGADO
  CANCELADO
}

enum DocType {
  BOLETA
  BOLETA_DNI
  FACTURA
}

model Order {
  id           String      @id @default(cuid())
  code         String      @unique
  customerName String
  phone        String
  /// recojo | delivery | evento
  deliveryType String      @default("recojo")
  address      String?
  scheduledFor String?
  notes        String?

  /// ── Comprobante ──
  docType      DocType @default(BOLETA)
  /// DNI si es boleta con DNI, RUC si es factura
  docNumber    String?
  /// Razón social, solo para factura
  businessName String?

  /// ── Envío ──
  /// gratis | costo | fuera, según los polígonos del mapa de cobertura
  deliveryZone String?
  deliveryFee  Decimal  @default(0) @db.Decimal(10, 2)
  /// Coordenadas de la dirección elegida, para replantear la ruta si hace falta
  lat          Float?
  lng          Float?

  /// Si el pedido es para un evento, queda unido a su solicitud de cotización.
  /// Sin @unique a propósito: un mismo evento puede acabar con varios pedidos,
  /// y además el índice único disparaba una alerta de pérdida de datos que
  /// habría bloqueado el despliegue.
  eventRequestId String?
  eventRequest   EventRequest? @relation(fields: [eventRequestId], references: [id], onDelete: SetNull)

  subtotal     Decimal     @db.Decimal(10, 2)
  /// Código de descuento usado, copiado tal cual. No es una relación a
  /// propósito: si el código se borra o se edita, el pedido tiene que seguir
  /// diciendo con cuál se cobró.
  discountCode   String?
  discountAmount Decimal  @default(0) @db.Decimal(10, 2)
  total        Decimal     @db.Decimal(10, 2)
  status       OrderStatus @default(PENDIENTE)
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  unitPrice Decimal  @db.Decimal(10, 2)
  quantity  Int
  /// Extras elegidos, serializados: [{"name":"Tapioca","price":2}]
  extras    String   @default("[]")
  lineTotal Decimal  @db.Decimal(10, 2)

  @@index([orderId])
}

// ───────────────────────────── Fidelidad ─────────────────────────────

enum LoyaltyEventType {
  SELLO
  PREMIO_MEDIO
  PREMIO_COMPLETO
  PREMIO_CUMPLE
  AJUSTE
}

model LoyaltyCustomer {
  id    String  @id @default(cuid())
  /// DNI o carné de extranjería
  dni   String  @unique
  name  String
  /// Obligatorio en los formularios; nullable en base solo para no romper
  /// las tarjetas creadas antes de que el campo fuera exigido.
  phone String?

  /// Fecha de nacimiento. Solo se usan día y mes para el premio.
  birthday           DateTime?
  /// Último año en que canjeó el premio de cumpleaños (uno por año)
  birthdayRewardYear Int?

  /// Sellos del ciclo actual (0 … meta)
  stamps        Int     @default(0)
  /// Sellos acumulados de por vida
  totalStamps   Int     @default(0)
  /// Tarjetas completadas
  cycles        Int     @default(0)
  /// Si ya usó el premio intermedio de este ciclo
  midRewardUsed Boolean @default(false)

  active    Boolean          @default(true)
  notes     String?
  events    LoyaltyEvent[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([name])
}

model LoyaltyEvent {
  id         String           @id @default(cuid())
  customerId String
  customer   LoyaltyCustomer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       LoyaltyEventType
  quantity   Int              @default(1)
  note       String?
  createdAt  DateTime         @default(now())

  @@index([customerId])
  @@index([createdAt])
}

// ───────────────────────────── Eventos ─────────────────────────────

enum EventStatus {
  NUEVA
  CONTACTADO
  COTIZADO
  CONFIRMADO
  CERRADO
  DESCARTADO
}

/// Solicitud de cotización que llega desde el formulario del sitio.
model EventRequest {
  id    String @id @default(cuid())
  code  String @unique
  name  String
  email String
  phone String

  /// Solo la fecha: la hora se acuerda por WhatsApp
  eventDate DateTime    @db.Date
  eventType String
  notes     String?
  status    EventStatus @default(NUEVA)

  /// Notas internas del equipo, no las ve el cliente
  internalNotes String?

  /// Pedidos de bebidas asociados, si la solicitud nació desde el carrito
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventDate])
  @@index([status])
}

/// Días que el equipo marca como no disponibles en el calendario público.
model BlockedDate {
  id     String   @id @default(cuid())
  date   DateTime @unique @db.Date
  reason String?

  createdAt DateTime @default(now())
}

// ───────────────────────────── Visitas ─────────────────────────────

model Visit {
  id String @id @default(cuid())

  /// Identificador anónimo del navegador, guardado en una cookie propia.
  /// No se registra IP ni user agent: con esto basta para contar personas
  /// distintas y evita guardar datos personales.
  visitorId String
  path      String
  referrer  String?

  /// true si venía con la cookie de vista previa: son visitas del equipo y
  /// se excluyen de las métricas para no inflar los números.
  team Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId])
  @@index([path])
}

// ───────────────────────────── Admin / Config ─────────────────────────────

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String   @default("Equipo Roa")
  passwordHash String
  createdAt    DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

// ───────────────────────────── Modo evento ─────────────────────────────
// La página /evento es para las ferias y los Pop Up: una carta reducida,
// con sus propios precios, que no toca la carta del local.

model EventProduct {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)

  /// Foto propia. Vacío: se dibuja la ilustración, igual que en la carta.
  imageUrl String?
  /// De qué familia es, para elegir los colores de la ilustración
  categorySlug String @default("sparkling-tea")
  /// bebida | comida | postre
  kind        String  @default("bebida")
  /// frio | caliente
  temperature String  @default("frio")
  /// Etiqueta de esquina: nuevo | estrella
  badge       String?

  position Int     @default(0)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, position])
}

model EventPhoto {
  id      String  @id @default(cuid())
  url     String
  caption String?

  position Int     @default(0)
  active   Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([active, position])
}

// ──────────────────────── Códigos de descuento ────────────────────────
// Solo descuentan productos de aliados. Las bebidas propias nunca entran:
// el margen de la marca aliada lo negocia ella, y un código suelto que
// rebajara toda la carta se comería el margen del local sin que nadie lo
// haya decidido.

model DiscountCode {
  id String @id @default(cuid())

  /// Se guarda siempre en MAYÚSCULAS y se compara así: nadie teclea un cupón
  /// respetando mayúsculas, y dos códigos que solo difirieran en eso serían
  /// indistinguibles para quien lo escribe.
  code String @unique

  /// porcentaje | monto
  kind  String  @default("porcentaje")
  value Decimal @db.Decimal(10, 2)

  /// Limitado a un aliado. Vacío: vale para los productos de cualquiera.
  allyId String?
  ally   Ally?   @relation(fields: [allyId], references: [id], onDelete: Cascade)

  /// Tope del descuento cuando es porcentaje. 0 = sin tope.
  maxDiscount Decimal @db.Decimal(10, 2) @default(0)
  /// Mínimo a gastar en productos de aliados para que valga. 0 = sin mínimo.
  minSubtotal Decimal @db.Decimal(10, 2) @default(0)

  /// Veces que puede usarse en total. 0 = ilimitado.
  maxUses   Int @default(0)
  /// Cuántas veces se usó ya. Lo lleva el servidor al registrar el pedido.
  usedCount Int @default(0)

  /// Ventana de validez. Vacías: sin límite por ese lado.
  startsAt DateTime?
  endsAt   DateTime?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([allyId])
}

// ─────────────────────── Pedidos del evento ───────────────────────
// Viven aparte de los pedidos del local y son temporales: cada feria es
// para otra empresa y otra fecha, y arrastrar los de la anterior ensucia
// la pantalla de la barra. Se borran cuando se cierra el evento, a mano
// y desde el panel: un borrado automático al apagar un interruptor se
// lleva por delante la jornada entera si alguien lo toca sin querer.

model EventOrder {
  id   String @id @default(cuid())
  /// Número corto que el cliente canta en la barra
  code String @unique

  customerName String
  phone        String?
  note         String?

  total  Decimal @db.Decimal(10, 2)
  /// PENDIENTE | ENTREGADO
  status String  @default("PENDIENTE")

  items EventOrderItem[]

  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

model EventOrderItem {
  id      String     @id @default(cuid())
  orderId String
  order   EventOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Copiados al momento del pedido: si después se edita la carta del
  /// evento, el ticket tiene que seguir diciendo qué se pidió y a cuánto
  name      String
  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int
  lineTotal Decimal @db.Decimal(10, 2)

  @@index([orderId])
}
