generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Catálogo ─────────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  tagline     String? // "Té frío + Fruta + bobas"
  description String?
  /// Tema visual de la sección: green | cream | black | purple
  theme       String    @default("green")
  emoji       String    @default("🧋")
  position    Int       @default(0)
  active      Boolean   @default(true)
  products    Product[]
  promos      Promo[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  price       Decimal     @db.Decimal(10, 2)
  imageUrl    String?
  /// nuevo | estrella | null
  badge       String?
  size        String? // "16oz", "12oz"
  /// Si entra en la promo automática de su categoría
  promoEligible Boolean   @default(true)
  featured    Boolean     @default(false)
  active      Boolean     @default(true)
  position    Int         @default(0)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// Si viene de una marca aliada. Estos productos NO salen en la carta:
  /// se muestran solo en la sección de aliados, aunque se compran igual.
  allyId String?
  ally   Ally?   @relation(fields: [allyId], references: [id], onDelete: SetNull)

  /// Promos que incluyen esta bebida. Si una promo no lista ninguna,
  /// entran todas las de su categoría.
  promos      Promo[]     @relation("PromoProducts")

  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId])
  @@index([allyId])
}

model Extra {
  id       String  @id @default(cuid())
  name     String
  price    Decimal @db.Decimal(10, 2)
  active   Boolean @default(true)
  position Int     @default(0)
}

model Promo {
  id         String    @id @default(cuid())
  title      String // "Sparkling Tea"
  label      String // "2x20"
  detail     String? // "Bebidas con Popping boba"
  price      Decimal   @db.Decimal(10, 2)
  /// Cantidad de bebidas incluidas en el combo
  quantity   Int       @default(2)
  imageUrl   String?
  theme      String    @default("purple")
  /// Se aplica sola en el carrito al juntar `quantity` bebidas de su categoría.
  /// Apagada por defecto: una categoría puede tener varias promos y hay que
  /// elegir explícitamente cuál cobra el carrito.
  autoApply  Boolean   @default(false)
  active     Boolean   @default(true)
  position   Int       @default(0)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Bebidas concretas que entran en la promo. Una categoría puede tener
  /// varias promos distintas (Matcha tiene 2x22 de frutados y 2x25), así que
  /// el interruptor por producto no alcanza para separarlas.
  /// Vacío significa "todas las de la categoría", que es como funcionaba antes.
  products   Product[] @relation("PromoProducts")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ───────────────────────────── Aliados ─────────────────────────────

/// Marcas aliadas: su historia, su galería y los productos que vendemos.
model Ally {
  id      String  @id @default(cuid())
  name    String
  slug    String  @unique
  /// Texto de la tarjeta del inicio, también se usa bajo el nombre en su página
  tagline String?
  /// Imagen de la tarjeta del inicio
  coverUrl String?
  /// Titular de la historia
  storyTitle String?
  /// Historia completa. Los saltos de línea dobles separan párrafos.
  story   String?
  logoUrl String?

  position Int     @default(0)
  active   Boolean @default(true)

  images   AllyImage[]
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AllyImage {
  id       String  @id @default(cuid())
  allyId   String
  ally     Ally    @relation(fields: [allyId], references: [id], onDelete: Cascade)
  url      String
  caption  String?
  position Int     @default(0)

  @@index([allyId])
}

// ───────────────────────────── Pedidos ─────────────────────────────

enum OrderStatus {
  PENDIENTE
  CONFIRMADO
  PREPARANDO
  ENTREGADO
  CANCELADO
}

enum DocType {
  BOLETA
  BOLETA_DNI
  FACTURA
}

model Order {
  id           String      @id @default(cuid())
  code         String      @unique
  customerName String
  phone        String
  /// recojo | delivery | evento
  deliveryType String      @default("recojo")
  address      String?
  scheduledFor String?
  notes        String?

  /// ── Comprobante ──
  docType      DocType @default(BOLETA)
  /// DNI si es boleta con DNI, RUC si es factura
  docNumber    String?
  /// Razón social, solo para factura
  businessName String?

  /// ── Envío ──
  /// gratis | costo | fuera, según los polígonos del mapa de cobertura
  deliveryZone String?
  deliveryFee  Decimal  @default(0) @db.Decimal(10, 2)
  /// Coordenadas de la dirección elegida, para replantear la ruta si hace falta
  lat          Float?
  lng          Float?

  /// Si el pedido es para un evento, queda unido a su solicitud de cotización.
  /// Sin @unique a propósito: un mismo evento puede acabar con varios pedidos,
  /// y además el índice único disparaba una alerta de pérdida de datos que
  /// habría bloqueado el despliegue.
  eventRequestId String?
  eventRequest   EventRequest? @relation(fields: [eventRequestId], references: [id], onDelete: SetNull)

  subtotal     Decimal     @db.Decimal(10, 2)
  total        Decimal     @db.Decimal(10, 2)
  status       OrderStatus @default(PENDIENTE)
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  unitPrice Decimal  @db.Decimal(10, 2)
  quantity  Int
  /// Extras elegidos, serializados: [{"name":"Tapioca","price":2}]
  extras    String   @default("[]")
  lineTotal Decimal  @db.Decimal(10, 2)

  @@index([orderId])
}

// ───────────────────────────── Fidelidad ─────────────────────────────

enum LoyaltyEventType {
  SELLO
  PREMIO_MEDIO
  PREMIO_COMPLETO
  PREMIO_CUMPLE
  AJUSTE
}

model LoyaltyCustomer {
  id    String  @id @default(cuid())
  /// DNI o carné de extranjería
  dni   String  @unique
  name  String
  /// Obligatorio en los formularios; nullable en base solo para no romper
  /// las tarjetas creadas antes de que el campo fuera exigido.
  phone String?

  /// Fecha de nacimiento. Solo se usan día y mes para el premio.
  birthday           DateTime?
  /// Último año en que canjeó el premio de cumpleaños (uno por año)
  birthdayRewardYear Int?

  /// Sellos del ciclo actual (0 … meta)
  stamps        Int     @default(0)
  /// Sellos acumulados de por vida
  totalStamps   Int     @default(0)
  /// Tarjetas completadas
  cycles        Int     @default(0)
  /// Si ya usó el premio intermedio de este ciclo
  midRewardUsed Boolean @default(false)

  active    Boolean          @default(true)
  notes     String?
  events    LoyaltyEvent[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([name])
}

model LoyaltyEvent {
  id         String           @id @default(cuid())
  customerId String
  customer   LoyaltyCustomer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       LoyaltyEventType
  quantity   Int              @default(1)
  note       String?
  createdAt  DateTime         @default(now())

  @@index([customerId])
  @@index([createdAt])
}

// ───────────────────────────── Eventos ─────────────────────────────

enum EventStatus {
  NUEVA
  CONTACTADO
  COTIZADO
  CONFIRMADO
  CERRADO
  DESCARTADO
}

/// Solicitud de cotización que llega desde el formulario del sitio.
model EventRequest {
  id    String @id @default(cuid())
  code  String @unique
  name  String
  email String
  phone String

  /// Solo la fecha: la hora se acuerda por WhatsApp
  eventDate DateTime    @db.Date
  eventType String
  notes     String?
  status    EventStatus @default(NUEVA)

  /// Notas internas del equipo, no las ve el cliente
  internalNotes String?

  /// Pedidos de bebidas asociados, si la solicitud nació desde el carrito
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventDate])
  @@index([status])
}

/// Días que el equipo marca como no disponibles en el calendario público.
model BlockedDate {
  id     String   @id @default(cuid())
  date   DateTime @unique @db.Date
  reason String?

  createdAt DateTime @default(now())
}

// ───────────────────────────── Visitas ─────────────────────────────

model Visit {
  id String @id @default(cuid())

  /// Identificador anónimo del navegador, guardado en una cookie propia.
  /// No se registra IP ni user agent: con esto basta para contar personas
  /// distintas y evita guardar datos personales.
  visitorId String
  path      String
  referrer  String?

  /// true si venía con la cookie de vista previa: son visitas del equipo y
  /// se excluyen de las métricas para no inflar los números.
  team Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId])
  @@index([path])
}

// ───────────────────────────── Admin / Config ─────────────────────────────

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String   @default("Equipo Roa")
  passwordHash String
  createdAt    DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}
